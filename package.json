    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron/packager": "^20.3.0",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "d3-force": "^3.0.0",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.5.0",
    "lucide": "^1.61.0",
    "markdown-it": "^15.0.3"
