{
  "name": "brain",
  "productName": "Brain",
  "version": "1.0.0",
  "description": "Editor de notas markdown inspirado en Obsidian, con sus funciones básicas",
  "author": "Miquel Baixas",
  "license": "MIT",
  "homepage": "https://github.com/miquelbaixas/brain",
  "repository": {
    "type": "git",
    "url": "https://github.com/miquelbaixas/brain.git"
  },
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dev": "node build.mjs --watch & electron .",
    "icon": "electron scripts/make-icon.cjs",
